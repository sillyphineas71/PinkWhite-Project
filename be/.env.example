# ==============================================================
# 🎯 PHASE 1: MODULE AUTH (CẦN CẤU HÌNH NGAY)
# ==============================================================

# 1. Môi trường cơ bản
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# 2. JWT Secrets (Có thể dùng tạm key mặc định này cho lúc dev)
JWT_ACCESS_SECRET="replace-with-strong-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret"
JWT_REFRESH_TTL="7d"
BCRYPT_ROUNDS=10

# 3. Email Service (Dùng để gửi mã xác nhận & lấy lại mật khẩu)
# Hướng dẫn: Dùng tài khoản Gmail, tạo "App Password" (Mật khẩu ứng dụng) 16 ký tự để điền vào SMTP_PASSWORD.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@yourdomain.com"

# 4. Google OAuth (Dùng cho UC009 Đăng nhập Google)
# Hướng dẫn: Vào Google Cloud Console -> Create Credentials -> OAuth Client ID
GOOGLE_CLIENT_ID="your-google-client-id"


# ==============================================================
# 🗄 DATABASE & INFRASTRUCTURE
# ==============================================================

# Database (Required for local PostgreSQL/PostGIS + Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/match_dev?schema=public"

# Redis (Future/runtime phase for realtime, queue, rate-limit, or caching)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Firebase / Push Notification (Future only, not used in phase 1)
FIREBASE_PROJECT_ID=""
